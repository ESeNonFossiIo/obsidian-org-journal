{
  "name": "org-journal",
  "version": "0.1.4",
  "private": true,
  "type": "module",
  "description": "Obsidian plugin: date-tree journal in an Org file",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "dev": "node esbuild.config.mjs --watch",
    "test": "node --test test/*.test.js",
    "preversion": "git fetch -q origin && test \"$(git rev-parse HEAD)\" = \"$(git rev-parse origin/master)\" && npm test",
    "version": "node -e \"const fs=require('fs'),v=process.env.npm_package_version,m=JSON.parse(fs.readFileSync('manifest.json')),w=JSON.parse(fs.readFileSync('versions.json'));m.version=v;w[v]=m.minAppVersion;fs.writeFileSync('manifest.json',JSON.stringify(m,null,2)+'\\n');fs.writeFileSync('versions.json',JSON.stringify(w,null,2)+'\\n')\" && git add manifest.json versions.json",
    "postversion": "git push origin HEAD \"$npm_package_version\""
  },
  "devDependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "esbuild": "^0.28.0"
  }
}
